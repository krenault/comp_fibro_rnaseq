# Copy to `.env` if you need to override paths. Do not commit `.env`.
#   set -a && source .env && set +a

# Analysis root (folder with scripts/generic_stress/). Usually unset; scripts detect it.
# FLEX_ROOT=/path/to/generic_stress

# Pairwise FH-experiment DESeq2 CSVs (separate contrasts, not the all-levels-together fit).
# Default: $FLEX_ROOT/drive_dge
# DRIVE_DGE=/path/to/DESeq_results_pairwise
