# Copy to .env and fill in. Nothing here is committed with secrets.

# Local working directory for per-species matrices and combined counts
DATA_DIR=/path/to/prepde_counts

# One-to-one ortholog TPM matrix (first column = ENSG IDs)
TPM=/path/to/TPM_13-species.one2one.csv

# Unity (process_stringtie.sh copies GTFs read-only)
UNITY_HOST=unity
UNITY_BASE=/project/pi_rachel_daniels_uri_edu/flexible_homeostasis

# prepDE.py -l; 75 is the tool default and matches the Drive production run
PREPDE_LENGTH=75
