# Copy to `.env` and fill in. Do not commit `.env`.

# Local working directory for per-species matrices and combined counts
DATA_DIR=/path/to/prepde_counts

# One-to-one ortholog TPM matrix (first column = ENSG IDs)
TPM=/path/to/TPM_orthologs.one2one.csv

# Remote host with StringTie GTFs (SSH alias or user@host)
HOST=mycluster
# Project root on that host containing <species>/<STRINGTIE_SUBDIR>/ directories
BASE=/path/to/rnaseq_project

# Space-separated species directory names under BASE (required by process_stringtie.sh)
SPECIES="speciesA speciesB speciesC"

# GTF subdirectory name under each species
STRINGTIE_SUBDIR=stringtie_one2one

# prepDE.py -l; 75 is the StringTie default
PREPDE_LENGTH=75
